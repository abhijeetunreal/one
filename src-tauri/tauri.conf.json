{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "One",
  "version": "0.1.0",
  "identifier": "com.example.one",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "One", "width": 420, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
